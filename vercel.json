{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/app.py": {
      "runtime": "vercel-python@0.0.0"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/app.py" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
